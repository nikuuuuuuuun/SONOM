# =============================================================================
# SONOM - Next.js Storefront Configuration
# Copy this file to .env.local and fill in your values
# =============================================================================

# Publishable API key from Medusa backend
# Create one at: Settings > Publishable API Keys in Medusa Admin
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only backend URL. On Vercel this must be the Cloudflare Tunnel URL.
# It is preferred over NEXT_PUBLIC_* by the server-side fetch wrapper.
MEDUSA_BACKEND_URL=https://api.sonom.cl

# Public backend URL (only needed if a browser must call Medusa directly).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.sonom.cl

# Cloudflare Access service token (optional). Required only when an Access
# policy protects the backend hostname. Create a Service Token in
# Cloudflare Zero Trust > Access > Service Auth.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Default region (country code)
NEXT_PUBLIC_DEFAULT_REGION=cl

# Base URL of the storefront (used for OG images, canonical URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Mercado Pago public key (kept for future embedded checkout integrations)
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Node environment
NODE_ENV=development
