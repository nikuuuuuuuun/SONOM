# =============================================================================
# SONOM - Medusa Backend Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database (Supabase PostgreSQL) ---
# Format: postgres://[user]:[password]@[host]:[port]/[database]
# Get these from your Supabase project dashboard > Project Settings > Database
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# true for Supabase / remote databases, false for localhost
DB_SSL=true
# Never enable in production/tunnel: it logs every query and leaks PII.
DATABASE_LOGGING=false

# --- CORS ---
# Storefront origins allowed to call /store/*. Include the Vercel production URL
# and every custom domain. Do NOT put the Mercado Pago back_url here.
STORE_CORS=http://localhost:8000,https://sonom.vercel.app,https://sonom.cl,https://www.sonom.cl
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://api.sonom.cl
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://api.sonom.cl

# --- Storefront (used for Mercado Pago back_urls, never for CORS) ---
STOREFRONT_URL=http://localhost:8000

# --- Redis (required for webhook retries / multi-process event bus) ---
# Leave empty to use the in-memory event bus (development only).
REDIS_URL=

# --- JWT & Session Secrets ---
# Production requires >= 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-this-to-a-random-secret-string
COOKIE_SECRET=change-this-to-another-random-secret-string

# --- Medusa Admin ---
DISABLE_MEDUSA_ADMIN=false
ADMIN_BACKEND_URL=http://localhost:9000

# --- Mercado Pago (Payment Gateway) ---
# Register at https://www.mercadopago.com/developers
MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Secret signature from Mercado Pago > Tus integraciones > Webhooks.
MERCADO_PAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public URL that Mercado Pago calls. Must be reachable through the tunnel.
MERCADO_PAGO_NOTIFICATION_URL=https://api.sonom.cl/webhooks/mercadopago
MERCADO_PAGO_STATEMENT_DESCRIPTOR=SONOM

# --- SII Chile: native electronic boleta (DTE 39) ---
# Replaces the old n8n workflow. The subscriber order.placed posts directly to
# this REST API and stores sii_status / sii_boleta_url in the order metadata.
SII_ENABLED=true
SII_API_URL=https://api.tu-proveedor.cl/v1/boletas
SII_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auth header used by your provider: Authorization (Bearer) or apikey (no prefix).
SII_API_KEY_HEADER=Authorization
SII_API_KEY_PREFIX=Bearer
SII_IDEMPOTENCY_HEADER=Idempotency-Key
SII_API_TIMEOUT_MS=15000
SII_API_MAX_ATTEMPTS=3
SII_DTE_TYPE=39

# Issuer (emisor) registered with SII.
SII_EMISOR_RUT=76123456-7
SII_EMISOR_RAZON_SOCIAL=SONOM SpA
SII_EMISOR_GIRO=Comercio al por menor de artesanias
SII_EMISOR_ACTIVIDAD_ECONOMICA=477300
SII_EMISOR_DIRECCION=Av. Ejemplo 1234
SII_EMISOR_COMUNA=Santiago
SII_EMISOR_CIUDAD=Santiago
SII_EMISOR_TELEFONO=
SII_EMISOR_EMAIL=ventas@sonom.cl

# Tax handling. Chilean prices are normally gross (IVA included).
SII_PRICES_INCLUDE_TAX=true
SII_IVA_RATE=0.19
SII_CONSUMIDOR_FINAL_RUT=66666666-6
# Optional: build the PDF URL if the provider only returns a folio.
# Supports {folio} and {id} placeholders.
SII_BOLETA_URL_TEMPLATE=

# --- File Storage (local for dev, S3 for production) ---
# For production, consider @medusajs/file-s3
UPLOAD_DIR=uploads
